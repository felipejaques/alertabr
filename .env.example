# ==================================
# AlertaBR - Environment Variables
# ==================================
# Copie este arquivo para .env e ajuste os valores

# Database
DB_NAME=alertabr
DB_USER=alertabr
DB_PASSWORD=alertabr

# Backend
DEBUG=false
DATABASE_URL=postgresql+asyncpg://alertabr:alertabr@db:5432/alertabr
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001

# APIs Externas (sem autenticação necessária na v1)
INMET_BASE_URL=https://apitempo.inmet.gov.br
IBGE_BASE_URL=https://servicodados.ibge.gov.br
